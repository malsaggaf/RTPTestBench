# Sender
WIDTH=1920
HEIGHT=1080
FPS=30
BITRATE_KBPS=4000
PAYLOAD_TYPE=96
HOST=192.168.10.11
PORT=5000
CLOCKOVERLAY_TEXT="SRC"

# Sender optional mode
SENDER_MODE=unicast     # unicast | multicast
MULTICAST_ADDR=239.0.0.1
MULTICAST_TTL=1

# Receiver
SINK_SYNC=true
TIMEOVERLAY_TEXT="SINK"
JITTERBUFFER_LATENCY_MS=50

# Network impairment (netem)
IFACE=eno1 #lo           # change to your NIC if using two machines
DELAY_MS=5
JITTER_MS=1
LOSS_PCT=0.0

# Presets (optional helper – edit manually if desired)
# RESOLUTION=720p  # options: 720p,1080p,480p
# When used, you can set WIDTH/HEIGHT accordingly.




